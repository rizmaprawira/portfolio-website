---
import { href, navigation } from "../data/site";
import Icon from "./home/Icon.astro";
const { current = "home" } = Astro.props;
const links = navigation;
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header shell">
  <a class="portfolio-brand" href={href()}>
    <span class="brand-mark" aria-hidden="true">
      rp.
    </span>
    <span>
      Rizma Prawira<small>Science, data & learning</small>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(({ key, label, path, icon }) => (
      <a href={href(path)} aria-current={current === key ? "page" : undefined}>
        <Icon name={icon} size={17} />
        {label}
      </a>
    ))}
  </nav>
  <a class="header-contact" href={href("contact/")}>
    <Icon name="mail" size={18} />
    Contact
  </a>
  <details class="mobile-nav">
    <summary>
      Menu <Icon name="plus" size={19} />
    </summary>
    <nav aria-label="Mobile navigation">
      {links.map(({ key, label, path, icon }) => (
        <a
          href={href(path)}
          aria-current={current === key ? "page" : undefined}
        >
          <Icon name={icon} size={20} />
          {label}
        </a>
      ))}
      <a href={href("contact/")}>
        <Icon name="mail" size={20} />
        Contact
      </a>
    </nav>
  </details>
</header>
