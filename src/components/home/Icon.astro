  wind: ['M3 7h12a3 3 0 1 0-3-3', 'M2 12h17a3 3 0 1 0-3-3', 'M4 17h10a3 3 0 1 1-3 3'],
  statistics: ['M4 3v17h17', 'M8 15v-4m5 4V7m5 8v-6'],
  math: ['M6 4h12l-8 8 8 8H6'],
  code: ['m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18'],
  science: ['M9 3h6m-5 0v7l-6 9a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2l-6-9V3', 'M7 15h10'],
  book: ['M12 5C8 2 5 3 2 4v15c4-1 7-1 10 1m0-15c4-3 7-2 10-1v15c-4-1-7-1-10 1V5Z'],
  data: ['M4 5c0-4 16-4 16 0s-16 4-16 0Z', 'M4 5v7c0 4 16 4 16 0V5M4 12v7c0 4 16 4 16 0v-7'],
  arrow: ['M5 19 19 5M5 5h14v14'],
  plus: ['M12 5v14M5 12h14'],
  compass: ['M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z', 'm16 8-3 5-5 3 3-5 5-3Z'],
  layers: ['m12 2 10 6-10 6L2 8l10-6Zm-10 11 10 5 10-5M2 18l10 5 10-5'],
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="line-icon">{(paths[name] ?? paths.compass).map(path => <path d={path} />)}</svg>
