---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;
const sources = import.meta.glob("/public/icons/lucide/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const source = sources[`/public/icons/lucide/${name}.svg`] as string;
if (!source) throw new Error(`Unknown Lucide icon: ${name}`);
const svg = source
  .replace("<svg", '<svg aria-hidden="true" class="v3-icon"')
  .replace('width="24"', `width="${size}"`)
  .replace('height="24"', `height="${size}"`)
  .replace('stroke-width="2"', 'stroke-width="1.6"');
---

<Fragment set:html={svg} />
