---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/home.css";
import "../styles/portfolio.css";
import "../styles/home-v3.css";
import "../styles/interior.css";
import { contact, href } from "../data/site";
interface Props {
  title: string;
  description: string;
  current?: string;
}
const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rizma Prawira",
  url: new URL(href(), Astro.site).href,
  sameAs: [contact.github, contact.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title === 'Home' ? 'Rizma Prawira — Atmosphere, data & learning' : `${title} — Rizma Prawira`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Notes & Perspectives"
      href={href("blog/rss.xml")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Rizma Prawira`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Rizma Prawira" />
    <meta
      property="og:image"
      content={new URL(href("images/rizma-prawira-960.webp"), Astro.site)}
    />
    <meta property="og:image:alt" content="Portrait of Rizma Prawira" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body
    id="top"
    class:list={[
      "portfolio-site",
      "v3-site",
      { "interior-site": current !== "home" },
    ]}
    data-section={current ?? "contact"}
  >
    <Header current={current} />
    <main id="main" class="shell scientific-home" tabindex="-1">
      <slot />
    </main>
    {current === "home" ? (
      <footer class="v3-footer shell">
        <span>© {new Date().getFullYear()} Rizma Prawira</span>
        <a href="#image-credits">Images & credits</a>
        <a href={href("blog/rss.xml")}>RSS</a>
        <a href="#top">Back to top ↑</a>
      </footer>
    ) : (
      <Footer />
    )}
  </body>
</html>
