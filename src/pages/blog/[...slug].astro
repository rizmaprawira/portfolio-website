---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../data/site";
import "katex/dist/katex.min.css";
export async function getStaticPaths() {
  return (
    await getCollection(
      "blog",
      ({ data }) => !data.draft && data.locale === "en",
    )
  ).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = Math.max(
  1,
  Math.ceil((post.body ?? "").split(/\s+/).length / 220),
);
const related = (
  await getCollection(
    "blog",
    ({ data, id }) =>
      !data.draft &&
      data.locale === "en" &&
      id !== post.id &&
      data.category === post.data.category,
  )
).slice(0, 3);
---

<Base
  title={post.data.title}
  description={post.data.description}
  current="blog"
>
  <article class="reading-content">
    <p class="eyebrow">{post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="article-meta">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-GB", {
          timeZone: "UTC",
          day: "numeric",
          month: "long",
          year: "numeric",
        })}
      </time>
      <span>{minutes} min read</span>
      <span>English</span>
    </p>
    <p>{post.data.description}</p>
    {post.data.cover && (
      <figure>
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          loading="eager"
        />
        {post.data.coverCaption && (
          <figcaption>{post.data.coverCaption}</figcaption>
        )}
      </figure>
    )}
    {headings.length > 4 && (
      <nav class="toc" aria-label="Article contents">
        <strong>In this article</strong>
        {headings
          .filter((heading) => heading.depth === 2)
          .map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
      </nav>
    )}
    <Content />
    {post.data.tags.length > 0 && (
      <p class="article-meta">Tags: {post.data.tags.join(", ")}</p>
    )}
    {related.length > 0 && (
      <section>
        <h2>Related notes</h2>
        {related.map((item) => (
          <p>
            <a href={href(`blog/${item.id}/`)}>{item.data.title}</a>
          </p>
        ))}
      </section>
    )}
    <a class="button button-light" href={href("blog/")}>
      Back to the journal
    </a>
  </article>
</Base>
