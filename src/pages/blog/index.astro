---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/portfolio/PageHero.astro";
import Icon from "../../components/home/Icon.astro";
import { copy } from "../../data/copy";
import { categories, href } from "../../data/site";
const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.locale === "en")
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Notes & Perspectives"
  description="A space for curiosity, experiments, and everything in between."
  current="blog"
>
  <PageHero
    label="The journal"
    title="Notes & Perspectives"
    description="A space for curiosity, experiments, and everything in between."
    icon="book"
  />
  <section class="journal-welcome portfolio-section">
    <div>
      <h2>Welcome to my little corner of the internet.</h2>
      <p>{copy.blog[0]}</p>
      <p>{copy.blog[1]}</p>
      <details class="quiet-details">
        <summary>
          About this notebook <Icon name="plus" size={17} />
        </summary>
        {copy.blog.slice(2, 5).map((p) => (
          <p>{p}</p>
        ))}
      </details>
    </div>
    <div class="journal-topics">
      {categories.map((category, i) => (
        <button
          class="journal-category-preview"
          type="button"
          data-category-choice={category.name}
          aria-pressed="false"
          aria-label={`Browse ${category.name}`}
        >
          <Icon name={["weather", "code", "book", "user"][i]} size={44} />
          <span>
            <strong>{category.name}</strong>
            <span class="category-description">{category.description}</span>
          </span>
        </button>
      ))}
    </div>
  </section>
  <div class="filter-toolbar">
    <label>
      Browse by category{" "}
      <select data-post-filter>
        <option>All notes</option>
        {categories.map((category) => (
          <option>{category.name}</option>
        ))}
      </select>
    </label>
    <a href={href("blog/rss.xml")}>Follow the RSS feed</a>
  </div>
  <section class="post-grid portfolio-section" aria-label="Blog articles">
    {posts.map((post) => (
      <article class="post-card" data-post-category={post.data.category}>
        {post.data.cover && (
          <img
            src={post.data.cover}
            alt={post.data.coverAlt ?? ""}
            loading="lazy"
          />
        )}
        <p class="eyebrow">{post.data.category}</p>
        <h2>
          <a href={href(`blog/${post.id}/`)}>{post.data.title}</a>
        </h2>
        <p class="article-meta">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-GB", {
              timeZone: "UTC",
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </time>
          <span>
            {Math.max(
              1,
              Math.ceil((post.body ?? "").split(/\s+/).length / 220),
            )}{" "}
            min read
          </span>
        </p>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
  <div
    class="subject-empty"
    data-post-empty
    aria-live="polite"
    hidden={posts.length > 0}
  >
    <h2>The notebook is open.</h2>
    <p data-post-empty-copy>
      No articles published yet. Future notes will appear here.
    </p>
  </div>
</Base>
<script>
  const select =
    document.querySelector<HTMLSelectElement>("[data-post-filter]");
  function filterPosts() {
    let visible = 0;
    document
      .querySelectorAll<HTMLElement>("[data-post-category]")
      .forEach((item) => {
        item.hidden =
          select!.value !== "All notes" &&
          item.dataset.postCategory !== select!.value;
        if (!item.hidden) visible++;
      });
    const empty = document.querySelector<HTMLElement>("[data-post-empty]");
    if (empty) empty.hidden = visible > 0;
    const text = document.querySelector("[data-post-empty-copy]");
    if (text)
      text.textContent =
        select!.value === "All notes"
          ? "No articles published yet. Future notes will appear here."
          : `No articles published in ${select!.value} yet.`;
    document
      .querySelectorAll<HTMLButtonElement>("[data-category-choice]")
      .forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.categoryChoice === select?.value),
        ),
      );
  }
  select?.addEventListener("change", filterPosts);
  document
    .querySelectorAll<HTMLButtonElement>("[data-category-choice]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        if (select) {
          select!.value = button.dataset.categoryChoice!;
          filterPosts();
        }
      }),
    );
</script>
