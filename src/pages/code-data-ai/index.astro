---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/portfolio/PageHero.astro";
import Icon from "../../components/home/Icon.astro";
import Build from "../../components/home/Build.astro";
import { resources } from "../../data/home";
import { href } from "../../data/site";
import { copy } from "../../data/copy";
import postal from "../../data/postal-preview.json";
---

<Base title="Code, Data & AI" description={copy.ai[0]} current="code">
  <PageHero
    label="Code, Data & AI"
    title={copy.ai[0]}
    description={copy.ai[1]}
    icon="code"
  />
  <section class="public-data-feature">
    <div>
      <p class="eyebrow">
        <Icon name="data" size={22} />
        Public repository
      </p>
      <h2>
        Indonesian Postal Code
        <br />
        Dataset & Crawler
      </h2>
      <p>
        Postal-code information collected from Pos Indonesia, with structured
        exports, validation checks, and documented source limitations.
      </p>
      <a class="button" href={href("code-data-ai/indonesian-postal-codes/")}>
        Explore the dataset <Icon name="arrow" size={18} />
      </a>
      <a class="inline-link" href={postal.repository}>
        View GitHub repository <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="public-data-preview">
      <p class="eyebrow">Five source records · Gambir, Jakarta Pusat</p>
      <div
        class="dataset-table"
        role="region"
        tabindex="0"
        aria-label="Public postal-code source sample"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">Postal code</th>
              <th scope="col">Kelurahan</th>
              <th scope="col">Kecamatan</th>
            </tr>
          </thead>
          <tbody>
            {postal.rows.map((row) => (
              <tr>
                <td>{row.Kodepos}</td>
                <td>{row["Desa / Kelurahan"]}</td>
                <td>{row.Kecamatan}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="resource-metadata">
        Sample only; source-dependent coverage.{" "}
        <a href={postal.source}>Original CSV</a>
      </p>
    </div>
  </section>
  <section class="profile-section">
    <h2>How I build with AI</h2>
    <Build showShelf={false} />
  </section>
  <details class="quiet-details research-intro">
    <summary>More about my approach</summary>
    {copy.ai.slice(3).map((p) => (
      <p>{p}</p>
    ))}
    <p>
      I am more confident in applying, adapting, and evaluating code than
      writing complex software independently from scratch.
    </p>
    <p>
      My strength is using AI-assisted development to bridge the gap between an
      idea and a usable solution—not claiming to be a conventional software
      engineer.
    </p>
  </details>
  <section class="profile-section">
    <h2>Explore the library</h2>
    <div class="filter-toolbar">
      <label>
        Resource type{" "}
        <select data-resource-filter>
          <option>All</option>
          <option>Datasets</option>
          <option>Scripts & Tools</option>
          <option>Tutorials & Guides</option>
        </select>
      </label>
      <p class="resource-metadata" aria-live="polite" data-library-count>
        6 resources
      </p>
    </div>
    <div class="resource-cards">
      {resources.map((resource) => (
        <article class="resource-card" data-library-type={resource.type}>
          <div class="resource-card-icon">
            <Icon
              name={
                resource.type === "Datasets"
                  ? "data"
                  : resource.type === "Scripts & Tools"
                    ? "code"
                    : "book"
              }
              size={36}
            />
            <span>{resource.type}</span>
          </div>
          <span class="resource-status">{resource.status}</span>
          <h3>{resource.title}</h3>
          <p>{resource.description.split(". ")[0]}.</p>
          <a
            class="button button-light"
            href={href(`code-data-ai/${resource.slug}/`)}
          >
            Resource details <Icon name="arrow" size={16} />
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
<script>
  const select = document.querySelector<HTMLSelectElement>(
    "[data-resource-filter]",
  );
  select?.addEventListener("change", () => {
    let count = 0;
    document
      .querySelectorAll<HTMLElement>("[data-library-type]")
      .forEach((item) => {
        item.hidden =
          select.value !== "All" && item.dataset.libraryType !== select.value;
        if (!item.hidden) count++;
      });
    const label = document.querySelector("[data-library-count]");
    if (label) label.textContent = `${count} resources`;
  });
</script>
