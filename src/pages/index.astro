---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Research from '../components/home/Research.astro';
import Experience from '../components/home/Experience.astro';
import Teaching from '../components/home/Teaching.astro';
import Build from '../components/home/Build.astro';
import Journal from '../components/home/Journal.astro';
import ScientificSlot from '../components/home/ScientificSlot.astro';
import Icon from '../components/home/Icon.astro';
import { copy } from '../data/copy';
import { heroFigure } from '../data/scientific-assets';
import '../styles/home.css';
const projects = (await getCollection('research', ({data}) => data.locale === 'en')).sort((a,b) => a.data.order - b.data.order).filter(project => ['enso-rainfall', 'cyclone-senyar', 'extreme-precipitation'].includes(project.id));
---
<Base title="Home" description="Rizma Prawira — Meteorology graduate, researcher, data enthusiast, and educator in Bandung, Indonesia." current="home">
  <div class="scientific-home">
    <section class="science-hero" aria-labelledby="home-heading"><div class="hero-byline"><span>Rizma Prawira</span><span>Bandung, Indonesia</span></div><div class="hero-composition"><div class="hero-copy"><h1 id="home-heading">{copy.headline}</h1><p>{copy.supporting}</p><a class="home-link" href="#selected-research">Explore my research <Icon name="arrow" size={17} /></a></div><div class="hero-visual"><ScientificSlot asset={heroFigure} /><div class="hero-disciplines"><span>Meteorology Graduate</span><span>Researcher</span><span>Data Enthusiast</span><span>Educator</span></div></div></div></section>
    <section id="about" class="home-about" aria-labelledby="about-heading"><div><h2 id="about-heading">Science is where<br />my curiosity starts.</h2><a class="home-link" href="#experience-heading">Explore my experience <Icon name="arrow" size={16} /></a></div><div><p>{copy.bio[0]}</p><p>{copy.bio[4]}</p></div></section>
    <Research projects={projects} />
    <Experience />
    <Teaching />
    <Build />
    <Journal />
  </div>
</Base>
