---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchList from '../components/ResearchList.astro';
import { href } from '../data/site';
import { copy } from '../data/copy';
const projects = (await getCollection('research', ({data}) => data.locale === 'en')).sort((a,b) => a.data.order - b.data.order).slice(0,2);
---
<Base title="Home" description="Rizma Prawira — Meteorology graduate, researcher, data enthusiast, and educator in Bandung, Indonesia." current="home">
  <section class="hero">
    <div class="hero-context"><p>Bandung, Indonesia</p><p><span>Meteorology Graduate</span><span>Researcher</span><span>Data Enthusiast</span><span>Educator</span></p></div>
    <div class="hero-main"><h1>{copy.headline}</h1><p class="hero-description">{copy.supporting}</p><a class="text-link" href={href('research/')}>Explore my research <span aria-hidden="true">↗</span></a></div>
  </section>
  <section id="about" class="margin-section about-section"><h2 class="section-label">A little about me</h2><div class="reading"><p class="intro">{copy.bio[0]}</p><p>{copy.bio[4]}</p></div></section>
  <section class="research-section"><div class="section-heading"><h2>Selected research</h2><a class="text-link" href={href('research/')}>All research <span aria-hidden="true">↗</span></a></div><ResearchList projects={projects} compact /></section>
  <section class="two-paths"><article id="teaching"><p class="section-label">Teaching & learning</p><h2>{copy.teaching[0]}</h2><p>{copy.teaching[2]}</p><a class="text-link" href="mailto:rizmaprawira@gmail.com">Discuss private tutoring <span aria-hidden="true">↗</span></a></article><article id="code-data-ai"><p class="section-label">Code, Data & AI</p><h2>Human curiosity.<br />AI-accelerated execution.</h2><p>{copy.ai[2]}</p><a class="text-link" href="https://github.com/rizmaprawira/kodepos_indonesia">Indonesian Postal Code Dataset & Crawler <span aria-hidden="true">↗</span></a></article></section>
  <section class="margin-section notes-preview"><h2 class="section-label">From the notebook</h2><div><h2>Notes & Perspectives</h2><p class="reading">A space for curiosity, experiments, and everything in between.</p><p class="muted">No articles published yet.</p><a class="text-link" href={href('blog/')}>Visit the journal <span aria-hidden="true">↗</span></a></div></section>
</Base>
