---
import Base from "../layouts/Base.astro";
import Icon from "../components/v3/Icon.astro";
import Media from "../components/portfolio/Media.astro";
import FigureViewer from "../components/home/FigureViewer.astro";
import { copy } from "../data/copy";
import { href, contact } from "../data/site";
import { entries, featuredResearch, journalTopics } from "../data/home-v3";
import { experience, subjects } from "../data/home";
import { projectMedia } from "../data/projects";
import manifest from "../data/image-manifest.json";
import postal from "../data/postal-preview.json";
const subjectIcons = [
  "chart-no-axes-column",
  "cloud-rain",
  "sigma",
  "code-xml",
  "flask-conical",
  "book-open",
];
const subjectSummaries = subjects.map((subject) => subject.topics);
---

<Base
  title="Home"
  description="Rizma Prawira — meteorology graduate, researcher, data enthusiast, and educator in Bandung, Indonesia."
  current="home"
>
  <section class="v3-hero" aria-labelledby="hello">
    <div class="v3-hero-copy">
      <p class="v3-kicker">
        Hello, I’m <span aria-hidden="true">/</span> Bandung, Indonesia
      </p>
      <h1 id="hello">
        Rizma Prawira<span>.</span>
      </h1>
      <p class="v3-position">{copy.headline}</p>
      <p class="v3-support">
        Meteorology graduate, researcher, data enthusiast, and educator based in
        Bandung, Indonesia.
      </p>
      <div class="v3-actions">
        <a class="v3-button" href="#work">
          Explore my work <Icon name="arrow-up-right" size={18} />
        </a>
        <a class="v3-text-link" href={href("teaching/")}>
          Learn with me <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </div>
    <figure class="v3-portrait">
      <div class="v3-portrait-frame">
        <Media
          name="rizma-prawira"
          alt="Rizma Prawira smiling with her arms crossed."
          eager
        />
      </div>
      <figcaption>
        <Icon name="map-pin" size={17} />
        <span>Bandung, Indonesia · Meteorology, ITB</span>
      </figcaption>
    </figure>
  </section>

  <section class="v3-entry-section" aria-labelledby="what-i-do">
    <div class="v3-mini-heading">
      <h2 id="what-i-do">What I do</h2>
      <span>Choose a starting point</span>
    </div>
    <nav class="v3-entries" aria-label="Explore my work by area">
      {entries.map((entry) => (
        <a class={`v3-entry ${entry.tone}`} href={href(entry.path)}>
          <div class="v3-entry-top">
            <span class="v3-symbol">
              <Icon name={entry.icon} size={32} />
            </span>
            <Icon name="arrow-up-right" size={19} />
          </div>
          <h3>{entry.title}</h3>
          <p>{entry.text}</p>
        </a>
      ))}
    </nav>
  </section>

  <section class="v3-section" id="work" aria-labelledby="research-heading">
    <div class="v3-heading">
      <div>
        <p class="v3-kicker">01 / Research in focus</p>
        <h2 id="research-heading">Research in the real world.</h2>
      </div>
      <a class="v3-text-link" href={href("research/")}>
        View all research <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
    <div class="v3-research-grid">
      {featuredResearch.map((project, index) => {
        const media = projectMedia[project.slug];
        const asset = manifest.find((a) => a.slug === project.image)!;
        return (
          <article
            class:list={[
              "v3-research-feature",
              { "v3-research-lead": index === 0 },
            ]}
          >
            <div class="v3-project-visual">
              <a
                href={href(`research/${project.slug}/`)}
                aria-label={`Read project: ${project.title}`}
              >
                {project.slug === "cyclone-senyar" ? (
                  <img
                    src={href("images/cyclone-senyar-panel-a.webp")}
                    width="570"
                    height="282"
                    alt="Panel (a): moisture-flux convergence and 850-hPa vorticity, including the supplied axes, legend, and event markers."
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Media name={project.image} alt={media.alt} />
                )}
              </a>
              <span class="v3-image-label">
                {index === 0
                  ? "ENSO / Rainfall"
                  : index === 1
                    ? "Tropical meteorology · Panel (a) excerpt"
                    : "Science in the community"}
              </span>
            </div>
            <div class="v3-project-copy">
              <div class="v3-project-meta">
                <span>{project.context}</span>
                <span class="v3-badge">{project.status}</span>
              </div>
              <h3>
                <a href={href(`research/${project.slug}/`)}>
                  {project.shortTitle}
                </a>
              </h3>
              <p>{project.description}</p>
              <div class="v3-project-actions">
                <a
                  class="v3-text-link"
                  href={href(`research/${project.slug}/`)}
                >
                  Explore project <Icon name="arrow-up-right" size={16} />
                </a>
                <FigureViewer
                  id={`v3-${project.image}`}
                  title={project.title}
                  asset={{
                    src: href(`images/${project.image}${asset.extension}`),
                    width: asset.dimensions[0],
                    height: asset.dimensions[1],
                    alt: media.alt,
                    caption: media.caption,
                    sourceLabel: "Supplied by Rizma Prawira",
                  }}
                />
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="v3-proof" aria-labelledby="highlights-heading">
    <div class="v3-proof-heading">
      <p class="v3-kicker">A few highlights</p>
      <h2 id="highlights-heading">Work that adds up.</h2>
    </div>
    <div class="v3-proof-grid">
      <a href={href("research/")}>
        <Icon name="notebook-pen" size={30} />
        <strong>2</strong>
        <span>
          Public research
          <br />
          preprints
        </span>
        <Icon name="arrow-up-right" size={19} />
      </a>
      <a class="v3-award" href={href("experience/")}>
        <Icon name="graduation-cap" size={34} />
        <strong>
          1st<span>place</span>
        </strong>
        <span>
          Most Outstanding Student
          <br />
          FITB ITB · 2025
        </span>
        <Icon name="arrow-up-right" size={19} />
      </a>
      <a href={href("teaching/")}>
        <Icon name="book-open" size={30} />
        <strong>150+</strong>
        <span>
          Students guided in
          <br />
          Basic Statistics
        </span>
        <Icon name="arrow-up-right" size={19} />
      </a>
      <a href={href("teaching/")}>
        <Icon name="layers" size={30} />
        <strong>9</strong>
        <span>
          University courses
          <br />
          assisted
        </span>
        <Icon name="arrow-up-right" size={19} />
      </a>
    </div>
  </section>

  <section
    class="v3-section v3-experience"
    aria-labelledby="experience-heading"
  >
    <div class="v3-experience-intro">
      <p class="v3-kicker">02 / Along the way</p>
      <h2 id="experience-heading">Research meets practice.</h2>

      <a class="v3-text-link" href={href("experience/")}>
        About & experience <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
    <div class="v3-timeline">
      {experience.map((role, index) => (
        <details>
          <summary>
            <span class="v3-timeline-index">
              <Icon
                name={
                  index === 2
                    ? "briefcase-business"
                    : index === 3
                      ? "wind"
                      : "cloud-rain"
                }
                size={24}
              />
            </span>
            <span>
              <strong>{role.organization}</strong>
              <span>{role.title}</span>
            </span>
            <span class="v3-period">{role.period}</span>
            <Icon name="plus" size={18} />
          </summary>
          <p>
            {
              [
                "Tropical cyclones, ENSO teleconnections, atmospheric diagnostics, and scientific visualization.",
                "Climate projections, extreme precipitation, and climate-risk assessment.",
                "Parametric flood insurance, catastrophe-risk information, and AI-assisted reporting.",
                "ENSO-related variability and climatological wind analysis over Papua.",
              ][index]
            }{" "}
            <a href={href("experience/")}>Full experience ↗</a>
          </p>
        </details>
      ))}
    </div>
  </section>

  <section class="v3-section v3-teaching" aria-labelledby="teaching-heading">
    <figure class="v3-teaching-photo">
      <Media
        name="teaching-classroom"
        alt="Rizma teaching beside a whiteboard and a projected atmospheric visualization, with students in the foreground."
      />
      <figcaption>
        From atmospheric science to shared understanding.
        <span>Teaching photograph supplied by Rizma.</span>
      </figcaption>
    </figure>
    <div class="v3-teaching-copy">
      <p class="v3-kicker">03 / Teaching & learning</p>
      <h2 id="teaching-heading">Learn with me.</h2>
      <p>Making complex concepts easier to understand, one step at a time.</p>
      <div class="v3-teaching-paths">
        <a href={href("teaching/")}>
          <Icon name="graduation-cap" size={26} />
          <span>
            University teaching<small>Theory & practical assistantships</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
        <a href={href("contact/")}>
          <Icon name="user-round" size={26} />
          <span>
            Private tutoring<small>Personalized academic support</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
        <a href={href("teaching/")}>
          <Icon name="book-open" size={26} />
          <span>
            Learning resources<small>Library in preparation</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="v3-actions">
        <a class="v3-button" href={href("contact/")}>
          Ask about private tutoring <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </div>
    <div class="v3-learning-browser">
      <div class="v3-learning-top">
        <span class="v3-symbol">
          <Icon name="book-open" size={29} />
        </span>
        <div>
          <strong>Where would you like to start?</strong>
          <span>Explore a subject</span>
        </div>
      </div>
      <div
        class="v3-subject-controls"
        role="group"
        aria-label="Choose a learning subject"
      >
        {subjects.map((subject, index) => (
          <button
            type="button"
            data-subject={index}
            data-summary={subjectSummaries[index]}
            data-name={subject.name}
            data-href={href(
              `teaching/${subject.name.toLowerCase().replaceAll(" ", "-")}/`,
            )}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls="v3-subject-panel"
          >
            <Icon name={subjectIcons[index]} size={23} />
            {subject.name}
          </button>
        ))}
      </div>
      <noscript>
        <nav aria-label="Learning subjects">
          {subjects.map((subject) => (
            <a
              href={href(
                `teaching/${subject.name.toLowerCase().replaceAll(" ", "-")}/`,
              )}
            >
              {subject.name}
            </a>
          ))}
        </nav>
      </noscript>
      <div id="v3-subject-panel" aria-live="polite">
        <p class="v3-small" id="v3-subject-summary">
          {subjectSummaries[0]}
        </p>
        <a
          class="v3-text-link"
          id="v3-subject-link"
          href={href("teaching/statistics/")}
        >
          Explore Statistics <Icon name="arrow-up-right" size={16} />
        </a>
        <p class="v3-resource-status">
          Resource library in preparation. No lessons published yet.
        </p>
      </div>
    </div>
  </section>

  <section class="v3-section" aria-labelledby="code-heading">
    <div class="v3-heading">
      <div>
        <p class="v3-kicker">04 / Code, Data & AI</p>
        <h2 id="code-heading">
          Useful data.
          <br />
          Transparent process.
        </h2>
      </div>
      <a class="v3-text-link" href={href("code-data-ai/")}>
        Explore the hub <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
    <div class="v3-code-grid">
      <article class="v3-dataset">
        <div class="v3-dataset-bar">
          <span>
            <Icon name="database" size={20} /> kodepos_posindonesia.csv
          </span>
          <span class="v3-badge">Public repository</span>
        </div>
        <div class="v3-dataset-content">
          <h3>
            Indonesian Postal Code
            <br />
            Dataset & Crawler
          </h3>
          <p>
            Postal-code records from Pos Indonesia, with structured exports and
            validation checks.
          </p>
          <label class="v3-search">
            <Icon name="search" size={18} />
            <span class="v3-sr-only">
              Filter the five-row postal-code sample
            </span>
            <input
              id="postal-search"
              type="search"
              placeholder="Search this sample…"
              autocomplete="off"
            />
          </label>
          <div
            class="v3-table-region"
            role="region"
            aria-label="Postal code source sample"
            tabindex="0"
          >
            <table>
              <caption>
                Source sample · Gambir, Jakarta Pusat · DKI Jakarta
              </caption>
              <thead>
                <tr>
                  <th scope="col">Postal code</th>
                  <th scope="col">Kelurahan</th>
                  <th scope="col">Kecamatan</th>
                </tr>
              </thead>
              <tbody>
                {postal.rows.map((row) => (
                  <tr data-postal-row>
                    <td>{row.Kodepos}</td>
                    <td>{row["Desa / Kelurahan"]}</td>
                    <td>{row.Kecamatan}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p id="postal-result" class="v3-small" aria-live="polite">
            5 source records shown.
          </p>
          <p class="v3-data-limitation">
            Sample only; coverage depends on source records returned at
            collection time.
          </p>
          <a class="v3-text-link" href={postal.repository}>
            View repository <Icon name="arrow-up-right" size={17} />
          </a>
          <a class="v3-source-link" href={postal.source}>
            Original CSV source
          </a>
        </div>
      </article>
      <div class="v3-ai">
        <span class="v3-symbol">
          <Icon name="code-xml" size={29} />
        </span>
        <h3>{copy.ai[0]}</h3>
        <p>
          AI coding assistants are central to implementation. I define
          objectives, design workflows, apply domain knowledge, and check and
          interpret results.
        </p>
        <a class="v3-text-link" href={href("code-data-ai/")}>
          How I build with AI <Icon name="arrow-up-right" size={17} />
        </a>
        <div class="v3-upcoming">
          <p class="v3-kicker">On the workbench</p>
          <a href={href("code-data-ai/bmkg-python/")}>
            <span>
              Downloading BMKG data with Python<small>Planned guide</small>
            </span>
            <Icon name="arrow-up-right" size={17} />
          </a>
          <a href={href("code-data-ai/tel-viz/")}>
            <span>
              Tel-Viz
              <small>
                Atmospheric teleconnection visualization · Project draft
              </small>
            </span>
            <Icon name="arrow-up-right" size={17} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="v3-section v3-journal" aria-labelledby="journal-heading">
    <div>
      <p class="v3-kicker">05 / Notes & Perspectives</p>
      <h2 id="journal-heading">
        A little room
        <br />
        for curiosity.
      </h2>
      <p>
        Things I’m learning, ideas I’m exploring, and questions I’m still
        figuring out.
      </p>
      <a class="v3-text-link" href={href("blog/")}>
        Visit my digital notebook <Icon name="arrow-up-right" size={18} />
      </a>
      <span class="v3-journal-status">No articles published yet.</span>
    </div>
    <nav class="v3-journal-topics" aria-label="Blog topics">
      {journalTopics.map(([icon, title, hint]) => (
        <a href={href("blog/")}>
          <Icon name={icon} size={44} />
          <span>
            <strong>{title}</strong>
            <small>{hint}</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      ))}
    </nav>
  </section>

  <section class="v3-contact" aria-labelledby="contact-heading">
    <div>
      <p class="v3-kicker">Keep in touch</p>
      <h2 id="contact-heading">Let’s connect.</h2>
      <p>
        Curious about science, driven by data, and passionate about sharing
        knowledge.
      </p>
    </div>
    <div>
      <a class="v3-email" href={`mailto:${contact.email}`}>
        {contact.email}
        <Icon name="arrow-up-right" size={23} />
      </a>
      <div class="v3-contact-links">
        <a href={contact.linkedin}>LinkedIn</a>
        <a href={contact.github}>GitHub</a>
        <a href={href("cv/")}>CV availability</a>
      </div>
    </div>
  </section>
  <details class="v3-credits" id="image-credits">
    <summary>Images & credits</summary>
    <p>
      Portrait, research figures, project group photograph, and teaching
      photograph supplied by Rizma Prawira for this website. Full scientific
      figures retain their original composition and data colors. The Senyar
      thumbnail shows panel (a); its full original remains in the viewer. Icons:{" "}
      <a href="https://lucide.dev/">Lucide</a>,{" "}
      <a href={href("icons/lucide/LICENSE")}>ISC / MIT license</a>. Dataset
      sample: <a href={postal.source}>owner’s postal-code repository</a>. No
      AI-generated imagery.
    </p>
  </details>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>("[data-subject]")
      .forEach((button) =>
        button.addEventListener("click", () => {
          document
            .querySelectorAll("[data-subject]")
            .forEach((item) =>
              item.setAttribute("aria-pressed", String(item === button)),
            );
          document.getElementById("v3-subject-summary")!.textContent =
            button.dataset.summary!;
          const link = document.getElementById(
            "v3-subject-link",
          ) as HTMLAnchorElement;
          link.textContent = `Explore ${button.dataset.name} ↗`;
          link.href = button.dataset.href!;
        }),
      );
    const search = document.getElementById("postal-search") as HTMLInputElement;
    search.addEventListener("input", () => {
      let count = 0;
      document
        .querySelectorAll<HTMLTableRowElement>("[data-postal-row]")
        .forEach((row) => {
          row.hidden = !row
            .textContent!.toLowerCase()
            .includes(search.value.toLowerCase().trim());
          if (!row.hidden) count++;
        });
      document.getElementById("postal-result")!.textContent = count
        ? `${count} source record${count === 1 ? "" : "s"} shown.`
        : "No matching records in this five-row sample.";
    });
  </script>
</Base>
