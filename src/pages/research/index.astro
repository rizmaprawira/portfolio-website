---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/portfolio/PageHero.astro";
import ProjectCard from "../../components/portfolio/ProjectCard.astro";
import { copy } from "../../data/copy";
import { publications } from "../../data/publications";
const projects = (
  await getCollection("research", ({ data }) => data.locale === "en")
).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Research" description={copy.research[0]} current="research">
  <PageHero
    label="Research & publications"
    title="Research in the real world."
    description={copy.research[0]}
    icon="weather"
  />
  <details class="quiet-details research-intro">
    <summary>Read my research statement</summary>
    {copy.research.slice(1).map((p) => (
      <p>{p}</p>
    ))}
  </details>
  <div class="filter-toolbar">
    <label>
      Explore by topic{" "}
      <select data-research-filter>
        <option>All projects</option>
        <option>Atmosphere & climate</option>
        <option>Climate risk</option>
        <option>Environmental technology</option>
      </select>
    </label>
    <span data-research-count aria-live="polite">
      6 projects
    </span>
    <a href="#publications">Publications & preprints</a>
  </div>
  <section class="research-gallery" aria-label="Research projects">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>
  <section class="publication-list" id="publications">
    <h2>Publications & preprints</h2>
    {publications.map((pub) => (
      <article class="publication-record">
        <span>
          {pub.year}
          <br />
          {pub.status}
        </span>
        <div>
          <h3>
            <a href={pub.url}>{pub.title}</a>
          </h3>
          <p>{pub.authors}</p>
          <p>{pub.venue}</p>
        </div>
      </article>
    ))}
  </section>
</Base>

<script>
  const filter = document.querySelector<HTMLSelectElement>(
    "[data-research-filter]",
  );
  filter?.addEventListener("change", () => {
    let count = 0;
    document
      .querySelectorAll<HTMLElement>("[data-research-category]")
      .forEach((item) => {
        item.hidden =
          filter.value !== "All projects" &&
          item.dataset.researchCategory !== filter.value;
        if (!item.hidden) count++;
      });
    document.querySelector("[data-research-count]")!.textContent =
      `${count} ${count === 1 ? "project" : "projects"}`;
  });
</script>
